{
  "name": "yt-sponsor-detect",
  "version": "0.2.0",
  "description": "Experimental local classification of YouTube sponsor captions",
  "main": "src/background.js",
  "type": "module",
  "scripts": {
    "setup": "node scripts/download-model.js",
    "build": "npm run verify:model && webpack --mode production",
    "dev": "webpack --watch",
    "test": "node scripts/check.mjs && node audio-poc/check.mjs && node bench/check.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "bench:setup": "node bench/setup.mjs",
    "bench:dataset": "python3 bench/dataset.py",
    "bench:run": "node bench/run.mjs",
    "bench:tune": "node bench/tune.mjs",
    "bench:report": "node bench/report.mjs",
    "bench:serve": "node bench/serve.mjs",
    "audio:setup": "node audio-poc/assets.mjs",
    "audio:build": "node audio-poc/assets.mjs --verify && webpack --config audio-poc/webpack.config.js",
    "audio:verify": "node audio-poc/assets.mjs --verify",
    "audio:check": "node audio-poc/check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "bench-ort": "npm:onnxruntime-web@1.29.0",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.5.1",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.1.4",
    "@xenova/transformers": "^2.17.2"
  }
}
