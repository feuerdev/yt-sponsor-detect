{
  "name": "yt-sponsor-detect",
  "version": "0.1.0",
  "description": "Experimental local classification of YouTube sponsor captions",
  "main": "src/background.js",
  "type": "module",
  "scripts": {
    "setup": "node scripts/download-model.js",
    "build": "npm run verify:model && webpack --mode production",
    "dev": "webpack --watch",
    "debug": "node debug.js",
    "test": "node scripts/check.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "evaluate": "node test_classifier.js",
    "verify:model": "node scripts/verify-model.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.5.1",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.1.4"
  }
}
