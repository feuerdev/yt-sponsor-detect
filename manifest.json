{
  "manifest_version": 3,
  "name": "YouTube Sponsor Skipper",
  "version": "0.1.0",
  "description": "Automatically skips sponsored segments in YouTube videos.",
  "permissions": ["scripting", "webRequest", "storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["src/content.js"]
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["model/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
