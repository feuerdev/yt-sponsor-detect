{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Timed caption fixture",
  "type": "object",
  "required": [
    "videoId",
    "channelId",
    "durationSeconds",
    "language",
    "cues",
    "referenceSegments",
    "reviewedNegativeIntervals",
    "annotationCompleteness"
  ],
  "properties": {
    "videoId": {
      "type": "string",
      "minLength": 1
    },
    "channelId": {
      "type": "string",
      "minLength": 1
    },
    "durationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "language": {
      "const": "en"
    },
    "annotationCompleteness": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "referenceSegments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "category",
          "status"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "category": {
            "enum": [
              "sponsor",
              "selfpromo"
            ]
          },
          "status": {
            "enum": [
              "provisional",
              "reviewed",
              "uncertain",
              "disputed"
            ]
          }
        }
      }
    },
    "reviewedNegativeIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "status"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "const": "reviewed"
          }
        }
      }
    }
  },
  "$comment": "Cross-field interval, ordering, review-completeness and category constraints are enforced by contracts.mjs."
}
